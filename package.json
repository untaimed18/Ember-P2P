{
  "name": "ember-p2p",
  "version": "1.5.7",
  "description": "Decentralized P2P file sharing application",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
    "check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "bump-version": "node scripts/bump-version.mjs",
    "verify:release": "node scripts/verify-release-policy.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:locales": "node --test scripts/locales.test.mjs scripts/error-codes.test.mjs",
    "test:release-policy": "node --test scripts/*.test.mjs",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),s=p.join('node_modules','circle-flags','flags'),d=p.join('static','flags');if(!fs.existsSync(s)){process.exit(0);}fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).filter(f=>f.endsWith('.svg')).forEach(f=>fs.copyFileSync(p.join(s,f),p.join(d,f)));console.log('Copied flag SVGs to static/flags/');\""
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "circle-flags": "^2.8.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.1"
  }
}
